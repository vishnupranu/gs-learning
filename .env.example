# Database Configuration (PostgreSQL / Supabase)
DATABASE_URL="postgresql://username:password@localhost:5432/guidesoft"

# ── Application ────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3000/api"
NODE_ENV="development"

# ── JWT / Session ──────────────────────────────────────────────────────────
JWT_SECRET="your-super-secret-jwt-key-min-32-chars-change-this"
SESSION_MAX_AGE=604800   # 7 days in seconds

# ── Email (Gmail SMTP) ─────────────────────────────────────────────────────
ENABLE_EMAIL="false"
EMAIL_SERVER_HOST="smtp.gmail.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER="your-gmail@gmail.com"
EMAIL_SERVER_PASSWORD="your-app-password"
EMAIL_FROM="GuideSoft <noreply@guidesoftitsolutions.com>"
ADMIN_EMAIL="praveenkumar.kanneganti@gmail.com"

# ── Stripe ─────────────────────────────────────────────────────────────────
ENABLE_STRIPE="false"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_your_stripe_key"
STRIPE_SECRET_KEY="sk_test_your_stripe_key"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret"

# ── Razorpay ───────────────────────────────────────────────────────────────
ENABLE_RAZORPAY="false"
RAZORPAY_KEY_ID="rzp_test_your_key"
RAZORPAY_KEY_SECRET="your_razorpay_secret"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_your_key"

# ── UPI ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_UPI_ID="8884162999-4@ybl"
NEXT_PUBLIC_UPI_NAME="Praveenkumar"
NEXT_PUBLIC_WHATSAPP_NUMBER="+918884162999"

# ── Google OAuth ───────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ── Google Services ────────────────────────────────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"
NEXT_PUBLIC_GTM_ID="GTM-XXXXXXX"
NEXT_PUBLIC_GOOGLE_MAPS_KEY="your-google-maps-api-key"

# ── WhatsApp Business API ──────────────────────────────────────────────────
ENABLE_WHATSAPP="false"
WHATSAPP_ACCESS_TOKEN="your-whatsapp-access-token"
WHATSAPP_PHONE_NUMBER_ID="your-phone-number-id"
WHATSAPP_VERIFY_TOKEN="your-webhook-verify-token"

# ── Telegram Bot ───────────────────────────────────────────────────────────
ENABLE_TELEGRAM="false"
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"
TELEGRAM_CHAT_ID="your-admin-telegram-chat-id"

# ── Cloudflare AI ──────────────────────────────────────────────────────────
ENABLE_CLOUDFLARE_AI="false"
CLOUDFLARE_ACCOUNT_ID="your-cloudflare-account-id"
CLOUDFLARE_API_TOKEN="your-cloudflare-api-token"
CLOUDFLARE_AI_GATEWAY="https://gateway.ai.cloudflare.com/v1"

# ── OpenAI ─────────────────────────────────────────────────────────────────
OPENAI_API_KEY="sk-your-openai-api-key"

# ── Rate Limiting ──────────────────────────────────────────────────────────
RATE_LIMIT_MAX="100"
RATE_LIMIT_WINDOW_MS="900000"

# ── Security ───────────────────────────────────────────────────────────────
CORS_ORIGIN="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-this-to-random-32-char-string"

# ── Feature Flags ──────────────────────────────────────────────────────────
ENABLE_ANALYTICS="false"
ENABLE_AI="false"
ENABLE_AI_CHAT="false"
